# Ollama (local Qwen and other SLMs)
SLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
SLM_DEFAULT_MODEL=qwen2.5-coder:14b

# Logging: json | console
SLM_LOG_FORMAT=console
SLM_LOG_LEVEL=INFO

# OpenTelemetry tracing (none | console | otlp)
SLM_OTEL_ENABLED=0
SLM_OTEL_EXPORTER=none
SLM_OTEL_SERVICE_NAME=agent-hub-slm
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Local experiment tracking (SQLite)
SLM_EXPERIMENTS_ENABLED=1
# SLM_EXPERIMENTS_DB_PATH=.agent-hub/experiments.db
